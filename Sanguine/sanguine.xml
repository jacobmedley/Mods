<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<GameInfo>
	<!-- Keep the 100% discovery chance for barbarian camps -->
	<SecretSocieties>
        <Update>
            <Where SecretSocietyType="SECRETSOCIETY_SANGUINE_PACT" />
            <Set DiscoverAtBarbarianCampBaseChance="100" />
        </Update>
	</SecretSocieties>
	
	<!-- Keep universal XP gain for all vampires -->
	<Units>
        <Update>
            <Where UnitType="UNIT_VAMPIRE" />
            <Set CanEarnExperience="true" />
        </Update>
	</Units>
	
	<!-- Create custom trait for vampire bonuses -->
	<Types>
		<Row Type="TRAIT_VAMPIRE_MASTER" Kind="KIND_TRAIT"/>
	</Types>
	
	<Traits>
		<Row TraitType="TRAIT_VAMPIRE_MASTER" Name="Vampire Master" Description="Enhanced vampire abilities for chosen civilizations."/>
	</Traits>
	
